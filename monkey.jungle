project.manifest = manifest.xml

# Gradual type checking: catches the obvious mistakes without fighting the
# places where the SDK's own signatures have moved between releases.
project.typecheck = 1
project.optimization = 2

# Every device pulls in the bitmap fonts baked for its exact screen size and
# nothing else, so a build only ever carries one set of glyph sheets.
# Regenerate them with tools/make_fonts.py.

# 260x260
fenix7.resourcePath = $(fenix7.resourcePath);resources-260
fenix7pro.resourcePath = $(fenix7pro.resourcePath);resources-260
fenix7pronowifi.resourcePath = $(fenix7pronowifi.resourcePath);resources-260
